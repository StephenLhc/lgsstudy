// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 用戶模型 (Supabase Auth 整合)
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  avatar        String?
  role          UserRole  @default(READER)
  bio           String?   // 簡介
  title         String?   // 稱謂：牧者/學者/平信徒
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  // 關聯
  posts        Post[]
  comments     Comment[]
  likes        Like[]
  favorites    Favorite[]
  
  @@map("users")
}

// 用戶角色
enum UserRole {
  ADMIN      // 管理員
  AUTHOR     // 作者
  MODERATOR  // 版主
  READER     // 讀者
}

// 聖經書卷分類 (66卷)
model BibleBook {
  id          String    @id @default(cuid())
  name        String    @unique        // 中文名稱：創世記
  englishName String?                  // 英文名稱：Genesis
  testament   Testament                // 新舊約
  order       Int                      // 排序
  chapters    Int                      // 章數
  description String?                  // 簡介
  color       String?                  // 主題色彩
  
  // 關聯
  posts      Post[]
  
  @@map("bible_books")
}

// 新舊約
enum Testament {
  OLD        // 舊約 39卷
  NEW        // 新約 27卷
}

// 文章模型
model Post {
  id          String    @id @default(cuid())
  title       String                    // 標題
  slug        String    @unique         // URL 路徑
  content     String                    // MDX 內容
  excerpt     String?                   // 摘要
  coverImage  String?                   // 封面圖片
  published   Boolean   @default(false) // 發布狀態
  publishedAt DateTime?                 // 發布時間
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  // 統計數據
  viewCount   Int       @default(0)    // 閱讀次數
  likeCount   Int       @default(0)    // 點讚數
  commentCount Int      @default(0)    // 評論數
  
  // 關聯
  authorId    String
  author      User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  
  bibleBookId String?                   // 關聯聖經書卷
  bibleBook   BibleBook? @relation(fields: [bibleBookId], references: [id])
  
  categories  PostCategory[]
  tags        PostTag[]
  comments    Comment[]
  likes       Like[]
  favorites   Favorite[]
  
  @@map("posts")
}

// 文章分類 (主題分類)
model Category {
  id          String    @id @default(cuid())
  name        String    @unique        // 分類名稱
  slug        String    @unique        // 分類路徑
  description String?                  // 分類描述
  color       String?                  // 分類顏色
  icon        String?                  // 分類圖標
  order       Int       @default(0)    // 排序
  
  // 關聯
  posts      PostCategory[]
  
  @@map("categories")
}

// 文章-分類關聯表
model PostCategory {
  id         String   @id @default(cuid())
  postId     String
  categoryId String
  
  post       Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  
  @@unique([postId, categoryId])
  @@map("post_categories")
}

// 標籤模型 (關鍵字標籤)
model Tag {
  id          String    @id @default(cuid())
  name        String    @unique        // 標籤名稱
  slug        String    @unique        // 標籤路徑
  description String?                  // 標籤描述
  color       String?                  // 標籤顏色
  count       Int       @default(0)    // 使用次數
  
  // 關聯
  posts      PostTag[]
  
  @@map("tags")
}

// 文章-標籤關聯表
model PostTag {
  id     String @id @default(cuid())
  postId String
  tagId  String
  
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)
  
  @@unique([postId, tagId])
  @@map("post_tags")
}

// 評論模型 (支援三層嵌套)
model Comment {
  id        String    @id @default(cuid())
  content   String                    // 評論內容
  published Boolean   @default(false) // 發布狀態
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  
  // 嵌套評論支援 (最多三層)
  parentId  String?
  parent    Comment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies   Comment[] @relation("CommentReplies")
  
  // 關聯
  postId    String
  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  
  authorId  String
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  
  // 審核狀態
  isApproved Boolean  @default(false) // 是否已審核
  isReported Boolean  @default(false) // 是否被舉報
  
  @@map("comments")
}

// 點讚模型
model Like {
  id       String @id @default(cuid())
  postId   String
  userId   String
  createdAt DateTime @default(now())
  
  post     Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([postId, userId])
  @@map("likes")
}

// 收藏模型
model Favorite {
  id       String @id @default(cuid())
  postId   String
  userId   String
  createdAt DateTime @default(now())
  
  post     Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([postId, userId])
  @@map("favorites")
}
